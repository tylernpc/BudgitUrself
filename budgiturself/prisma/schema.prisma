// Prisma schema — https://pris.ly/d/prisma-schema
// Create a migration with `npm run db:migrate`, apply pending ones with `npm run db:deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  auth0Sub      String   @unique
  email         String   @unique
  firstName     String?
  lastName      String?
  bankBalance   Decimal  @default(0) @db.Decimal(12, 2)
  monthlyIncome Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creditCards     CreditCard[]
  monthlyExpenses MonthlyExpense[]
  bills           Bill[]
}

model CreditCard {
  id        String   @id @default(uuid())
  userId    String
  name      String
  balance   Decimal  @db.Decimal(12, 2)
  limit     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MonthlyExpense {
  id        String   @id @default(uuid())
  userId    String
  name      String
  amount    Decimal  @db.Decimal(12, 2)
  icon      String   @default("home")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum BillType {
  DIGITAL
  PERSONAL
}

/// Digital bills carry `card` + `category`; personal bills carry `owedTo`.
/// The pairing is enforced in the database via a CHECK constraint (see the
/// migration) and re-validated by the mapper. Prisma has no native
/// discriminated-union column type.
model Bill {
  id         String   @id @default(uuid())
  userId     String
  name       String
  amount     Decimal  @db.Decimal(12, 2)
  chargeDate Int
  type       BillType
  card       String?
  category   String?
  owedTo     String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
