// Prisma schema — https://pris.ly/d/prisma-schema
// Create a migration with `npm run db:migrate`, apply pending ones with `npm run db:deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  auth0Sub      String   @unique
  email         String   @unique
  firstName     String?
  lastName      String?
  bankBalance   Decimal  @default(0) @db.Decimal(12, 2)
  monthlyIncome Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creditCards     CreditCard[]
  monthlyExpenses MonthlyExpense[]
  bills           Bill[]
}

model CreditCard {
  id        String   @id @default(uuid())
  userId    String
  name      String
  balance   Decimal  @db.Decimal(12, 2)
  limit     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bills Bill[]

  @@index([userId])
}

model MonthlyExpense {
  id        String   @id @default(uuid())
  userId    String
  name      String
  amount    Decimal  @db.Decimal(12, 2)
  spent     Decimal  @default(0) @db.Decimal(12, 2)
  icon      String   @default("home")
  color     String   @default("violet")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum BillType {
  DIGITAL
  PERSONAL
  RECURRING
}

/// Digital bills carry `cardId` + `category`; personal bills carry `owedTo`;
/// recurring bills (rent, insurance, and the like) carry neither — just a
/// fixed name/amount/day. The pairing is enforced in the database via a
/// CHECK constraint (see the migration) and re-validated by the mapper.
/// Prisma has no native discriminated-union column type, so the branch
/// columns are nullable — but `cardId` is still a real foreign key, so a
/// bill can never name a card that does not exist, and deleting a card
/// takes its bills with it.
model Bill {
  id         String   @id @default(uuid())
  userId     String
  name       String
  amount     Decimal  @db.Decimal(12, 2)
  chargeDate Int
  type       BillType
  cardId     String?
  category   String?
  owedTo     String?
  createdAt  DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  card CreditCard? @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cardId])
}
