# Postgres via the transaction-mode pooler (used by the app at runtime)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Postgres via the session-mode pooler (used by Prisma Migrate)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth0: manage.auth0.com -> Applications -> your app -> Settings
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Encrypts the session cookie. Generate with: openssl rand -hex 32
AUTH0_SECRET=

# Public origin of this deployment
APP_BASE_URL=http://localhost:3000
